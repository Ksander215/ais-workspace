+/**
+ * Whether a path is a test file rather than implementation.
+ *
+ * Matches the common layouts: a `tests/` or `__tests__/` directory, and the
+ * `.test.` / `.spec.` / `.e2e.` filename conventions.
+ */
+function isTestFile(relativePath: string): boolean {
+  const p = relativePath.toLowerCase();
+  if (p.includes('/tests/') || p.includes('/__tests__/') || p.includes('/test/')) return true;
+  return /\.(test|spec|e2e)\.[cm]?[jt]sx?$/.test(p);
+}
