+  /**
+   * The files used when no graph node matched the question.
+   *
+   * The CONTEXT shown to the model and the EVIDENCE sources attached to the
+   * answer must come from the same files: otherwise the model is shown one
+   * set of excerpts while the claims cite another, and the evidence says
+   * nothing about what the answer was actually based on.
+   */
+  private fallbackEvidenceFiles(discovery: DiscoveryResult): Array<{ file: string; mod: ModuleBoundary }> {
+    const out: Array<{ file: string; mod: ModuleBoundary }> = [];
+    const seen = new Set<string>();
+    for (const mod of discovery.modules.slice(0, FALLBACK_MODULE_COUNT)) {
+      for (const file of this.findKeyFiles(mod, discovery, 2)) {
+        if (seen.has(file)) continue;
+        seen.add(file);
+        out.push({ file, mod });
+        if (out.length >= FALLBACK_FILE_COUNT) return out;
+      }
+    }
+    return out;
+  }
+
+  /**
+   * Render source excerpts for a fixed list of files.
+   */
+  private buildExcerptsForFiles(
+    files: readonly string[],
+    projectPath: string,
+    budgetChars: number,
+  ): string {
+    const blocks: string[] = [];
+    let usedChars = 0;
+    for (const file of files) {
+      if (usedChars >= budgetChars) break;
+      const excerpt = this.readSourceExcerpt(join(projectPath, file), EXCERPT_MAX_LINES);
+      if (!excerpt) continue;
+      const block = `\n### ${file}\n\`\`\`typescript\n${excerpt}\n\`\`\``;
+      if (usedChars + block.length > budgetChars) {
+        const shortExcerpt = this.readSourceExcerpt(join(projectPath, file), 15);
+        if (!shortExcerpt) continue;
+        const shortBlock = `\n### ${file}\n\`\`\`typescript\n${shortExcerpt}\n\`\`\``;
+        if (usedChars + shortBlock.length > budgetChars) continue;
+        blocks.push(shortBlock);
+        usedChars += shortBlock.length;
+      } else {
+        blocks.push(block);
+        usedChars += block.length;
+      }
+    }
+    return blocks.length > 0 ? '## Source Code Excerpts' + blocks.join('\n') : '';
+  }
